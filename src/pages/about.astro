---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/BlogPost.astro';

const [page] = await getCollection('about');
const { Content } = await render(page);
---

<div class="container">
<Layout
    title={page.data.title}
    description={page.data.description}
    pubDate={page.data.pubDate}
    updatedDate={page.data.updatedDate}
    heroImage={page.data.heroImage}
>

    <h1 class="introduction">
        Hello!, I'm {page.data.name} <i class="bi bi-braces-asterisk"></i>
    </h1>

    <p class="tagline">{page.data.tagline}</p>

    <div class="prose-content">
        <Content />
    </div>
</Layout>
</div>

<style>
    .container {
        animation-name: fadeIn;
        animation-duration: 1s;
        animation-timing-function: ease-in;
        animation-fill-mode: forwards;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .introduction {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }

    .tagline {
        font-size: 1.2rem;
        color: var(--text-secondary, #666);
        margin-bottom: 2rem;
        font-weight: 500;
    }

    .prose-content h2 {
        font-size: 1.8rem;
        margin-top: 3rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--accent-color, #3b82f6);
    }

    .prose-content h3 {
        font-size: 1.3rem;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }

    .prose-content h4 {
        font-size: 1.1rem;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .prose-content p {
        margin: 0.75rem 0;
    }

    .prose-content ul {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 1.5rem;
        background: var(--bg-secondary, #f9fafb);
        border-left: 4px solid var(--accent-color, #3b82f6);
        border-radius: 0.5rem;
        padding: 1rem 1.5rem;
    }

    .prose-content ul ul {
        background: transparent;
        border-left: none;
        padding: 0;
        margin: 0.5rem 0 0 1.5rem;
    }

    .prose-content li {
        padding: 0.4rem 0;
        padding-left: 1.5rem;
        position: relative;
    }

    .prose-content li:before {
        content: "→";
        position: absolute;
        left: 0;
        color: var(--accent-color, #3b82f6);
        font-weight: bold;
    }

    .prose-content strong {
        color: var(--black, #0f1219);
    }

    .prose-content a {
        color: var(--accent-color, #3b82f6);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.3s ease;
    }

    .prose-content a:hover {
        border-bottom-color: var(--accent-color, #3b82f6);
    }

    .prose-content blockquote {
        border-left: 4px solid var(--accent-color, #3b82f6);
        margin: 1.5rem 0;
        padding: 0.5rem 1.5rem;
        background: var(--bg-secondary, #f9fafb);
        border-radius: 0 0.5rem 0.5rem 0;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .introduction {
            font-size: 2rem;
        }

        .tagline {
            font-size: 1rem;
        }

        .prose-content h2 {
            font-size: 1.5rem;
        }
    }
</style>